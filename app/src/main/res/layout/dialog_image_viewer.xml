<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <WebView
        android:id="@+id/viewer_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/viewer_bottom_bar"
        android:layout_alignParentTop="true" />

    <!-- 底部导航栏：prev / counter / next -->
    <LinearLayout
        android:id="@+id/viewer_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#CC000000">

        <Button
            android:id="@+id/viewer_prev"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="◀"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/viewer_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1/1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/viewer_next"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="▶"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- 左上角按钮组：旋转 + 复位 + 背景色 -->
    <LinearLayout
        android:id="@+id/viewer_top_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="4dp"
        android:orientation="horizontal"
        android:background="#88000000">

        <Button
            android:id="@+id/viewer_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↻"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="#"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_bg_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="◐"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <!-- 导出当前预览为 PNG / JPEG，落到 exports/（小工具可预览） -->
        <Button
            android:id="@+id/viewer_export"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="存"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- 顶部文件名（文件查看器专用，其余模式隐藏） -->
    <TextView
        android:id="@+id/viewer_title"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/viewer_top_left"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="middle"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <!-- 右上角：预览 / 运行（仅 HTML·SVG·JS 附件显示） -->
    <Button
        android:id="@+id/viewer_preview"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/viewer_close"
        android:layout_marginTop="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:minWidth="0dp"
        android:text="预览"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:background="#88000000" />

    <!-- 右上角：关闭按钮 -->
    <Button
        android:id="@+id/viewer_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_margin="4dp"
        android:text="✕"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:background="#88000000" />

    <!-- 左侧下方：缩放按钮（竖向） -->
    <LinearLayout
        android:id="@+id/viewer_zoom_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/viewer_bottom_bar"
        android:layout_alignParentLeft="true"
        android:layout_margin="4dp"
        android:orientation="vertical"
        android:background="#88000000">

        <Button
            android:id="@+id/viewer_zoom_in"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_zoom_out"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="−"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />
    </LinearLayout>

</RelativeLayout>
