<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <WebView
        android:id="@+id/viewer_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/viewer_bottom_bar"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:id="@+id/viewer_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#CC000000">

        <Button
            android:id="@+id/viewer_prev"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="◀"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_zoom_out"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="⊖"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_zoom_in"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="⊕"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/viewer_rotate"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="↻"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/viewer_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1/1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/viewer_next"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="▶"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <Button
        android:id="@+id/viewer_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_margin="8dp"
        android:text="✕"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent" />

</RelativeLayout>
