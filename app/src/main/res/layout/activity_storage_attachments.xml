<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 分段：使用中 / 无引用。默认落在无引用，只有它有清理价值 -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/att_tab_used"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="使用中 0"/>
        <TextView
            android:id="@+id/att_tab_orphan"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="无引用 0"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp">
        <View
            android:id="@+id/att_ind_used"
            android:background="@color/storage_att"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/att_ind_orphan"
            android:background="@color/storage_att"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/att_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#fff8e1"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/att_hint"
            android:textSize="11sp"
            android:textColor="#8d6e00"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/att_select"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="多选"/>
        <TextView
            android:id="@+id/att_select_all"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:visibility="gone"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全选"/>
        <TextView
            android:id="@+id/att_cancel"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:visibility="gone"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"/>
        <TextView
            android:id="@+id/att_delete"
            android:textSize="12sp"
            android:textColor="@color/danger"
            android:visibility="gone"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"/>
    </LinearLayout>

    <!-- 空态与列表叠在一起：列表为空时若让两者上下排列，
         提示会被挤到屏幕最底部，看起来像加载失败 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/att_list"
            android:divider="#e0e0e0"
            android:dividerHeight="1dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/att_empty"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
