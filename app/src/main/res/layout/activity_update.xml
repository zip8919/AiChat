<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/activity_update_001"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/update_status"
            android:text="@string/activity_update_002"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_refresh"
                android:text="@string/activity_update_003"
                android:textSize="12sp"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"/>

            <Button
                android:id="@+id/btn_notes"
                android:text="@string/activity_update_004"
                android:textSize="12sp"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"/>

            <!-- 历史版本：列出全部版本、发布时间与更新日志，可下载任意一版 -->
            <Button
                android:id="@+id/btn_history"
                android:text="历史版本"
                android:textSize="12sp"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/update_asset"
                android:text="@string/activity_update_005"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:ellipsize="middle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btn_switch_asset"
                android:text="@string/activity_update_006"
                android:textSize="11sp"
                android:minHeight="36dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/activity_update_007"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_probe"
            android:text="@string/activity_update_008"
            android:textSize="11sp"
            android:minHeight="36dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"/>

        <Button
            android:id="@+id/btn_add"
            android:text="@string/activity_update_009"
            android:textSize="11sp"
            android:minHeight="36dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 并行测速：默认开，并发数 1~64 可自定义。窄屏上只占一行，
         设置入口做成按钮弹输入框，不再往标题栏里塞第三个控件。 -->
    <LinearLayout
        android:id="@+id/probe_option_row"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/probe_parallel_check"
            android:text="@string/activity_update_010"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:checked="true"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_probe_concurrency"
            android:text="@string/activity_update_011"
            android:textSize="11sp"
            android:minHeight="32dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:text="@string/activity_update_012"
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/custom_box"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/custom_input"
            android:hint="@string/activity_update_013"
            android:textSize="11sp"
            android:singleLine="true"
            android:inputType="textUri"
            android:padding="6dp"
            android:background="@color/white"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"/>

        <Button
            android:id="@+id/btn_custom_ok"
            android:text="@string/activity_update_014"
            android:textSize="11sp"
            android:minHeight="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 内置加速源已扩到 80+ 项：必须用 ListView 复用行。
         原来动态 addView 到 LinearLayout 的前提是「只有 7~9 项」，
         80 行一次性 inflate + 测量在 4.4 上是肉眼可见的卡顿。 -->
    <ListView
        android:id="@+id/mirror_list"
        android:divider="#e0e0e0"
        android:dividerHeight="1dp"
        android:cacheColorHint="@android:color/transparent"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/update_progress_text"
            android:text="@string/activity_update_015"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_action"
            android:text="@string/activity_update_016"
            android:textSize="13sp"
            android:minHeight="44dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
