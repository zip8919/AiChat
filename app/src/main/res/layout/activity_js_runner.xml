<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/js_back_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="返回"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="JS 运行器"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/js_run_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="运行"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_paste_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="粘贴"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_clear_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="清空"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_copy_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="复制输出"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_save_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="保存"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/js_code_input"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:gravity="top|start"
        android:hint="在此输入 JS / HTML / SVG 代码"
        android:inputType="textMultiLine"
        android:textSize="12sp"
        android:background="#F5F5F5"
        android:padding="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:padding="4dp"
        android:text="输出"
        android:textColor="#333333"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/js_output"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#FAFAFA"
        android:padding="4dp"
        android:scrollbars="vertical"
        android:textColor="#333333"
        android:textSize="11sp"
        android:typeface="monospace" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:padding="4dp"
        android:text="渲染结果"
        android:textColor="#333333"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/js_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
