<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/js_back_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/activity_js_runner_001"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/activity_js_runner_002"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/js_run_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/activity_js_runner_003"
            android:textSize="12sp" />

        <!-- 死循环停不下来，只能销毁 WebView 重来；按钮常驻但空闲时禁用 -->
        <Button
            android:id="@+id/js_abort_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/activity_js_runner_004"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_paste_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/activity_js_runner_005"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_save_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/activity_js_runner_006"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="@string/activity_js_runner_007"
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_clear_code_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/activity_js_runner_008"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/js_code_input"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:gravity="top|start"
        android:hint="@string/activity_js_runner_009"
        android:inputType="textMultiLine"
        android:textSize="12sp"
        android:background="#F5F5F5"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp">

        <!-- 运行状态就写在这一行：原先「输出」永远是两个字，
             用户点完运行不知道到底跑了没有 -->
        <TextView
            android:id="@+id/js_output_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="@string/activity_js_runner_010"
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_copy_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/activity_js_runner_011"
            android:textSize="12sp" />

        <Button
            android:id="@+id/js_clear_output_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/activity_js_runner_012"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/js_output_scroll"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#FAFAFA">

        <TextView
            android:id="@+id/js_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#333333"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:padding="4dp"
        android:text="@string/activity_js_runner_013"
        android:textColor="#333333"
        android:textSize="12sp" />

    <!-- WebView 由代码创建：中止运行时必须整个销毁重建，才能真的掐断死循环 -->
    <FrameLayout
        android:id="@+id/js_webview_host"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_weight="1" />
</LinearLayout>
</ScrollView>
