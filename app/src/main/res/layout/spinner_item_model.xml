<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏模型选择器「收起态」：两行。
     第一行模型名（可随宽度降字号、必要时中间省略保住版本号），
     第二行服务商（固定 10sp 小字灰、单行、不参与降级）。

     为什么不用单行 "name (provider)"：258dp 屏上文字区约 204dp，
     "deepseek-v4-flash · 商汤日日新" 在 13sp 就已经顶到 205dp，一个字都加不进去，
     再长的名字会把服务商整段挤掉——而服务商恰恰是这次要解决的问题。
     拆成两行后，模型名与服务商互不抢占宽度，长名字最多自己省略。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/model_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:maxLines="1"
        android:textSize="14sp"
        android:textColor="#333333"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/model_item_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:maxLines="1"
        android:textSize="10sp"
        android:textColor="#888888"
        android:ellipsize="end" />
</LinearLayout>
