<?xml version="1.0" encoding="utf-8"?>
<!--
  主题生成提示词模板编辑页。

  为什么单独开一页而不塞进设置页：模板正文五六千字，放进设置页会把整页撑成
  超长滚动，且设置页是「统一保存」语义，长文本编辑容易误触别的开关。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:text="@string/activity_theme_prompt_001" />

    <LinearLayout
        android:id="@+id/template_chips"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/template_edit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:gravity="top"
        android:background="@drawable/edit_text_background"
        android:padding="10dp"
        android:textSize="11sp"
        android:typeface="monospace"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="textMultiLine"
        android:hint="@string/activity_theme_prompt_002" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:text="@string/activity_theme_prompt_003" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:text="@string/activity_theme_prompt_004" />
    </LinearLayout>
</LinearLayout>
