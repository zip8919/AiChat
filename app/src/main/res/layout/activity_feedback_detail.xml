<?xml version="1.0" encoding="utf-8"?>
<!-- 反馈详情：只展示公开字段，联系方式与批注不在客户端出现。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/detail_back"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_002" />

            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_001" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_loading"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackdetailactivity_009" />

        <LinearLayout
            android:id="@+id/detail_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/detail_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/detail_type"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_placeholder_chip"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/detail_status"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_placeholder_chip"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginLeft="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_meta"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/detail_summary_label"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_007" />

            <TextView
                android:id="@+id/detail_summary"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_006" />

            <TextView
                android:id="@+id/detail_body"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_008" />

            <LinearLayout
                android:id="@+id/detail_attachments"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/detail_attachments_hint"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                android:paddingTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedbackdetailactivity_011" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
