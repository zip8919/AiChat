<?xml version="1.0" encoding="utf-8"?>
<!-- 模型编辑页：提供商下拉 + 模型 ID + 显示名 + 能力开关 + 连通性测试 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/me_back"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_model_edit_001" />
            <TextView
                android:id="@+id/me_title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/activity_model_edit_002" />
        </LinearLayout>

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_003" />
        <Spinner
            android:id="@+id/me_provider"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/me_provider_info"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_004" />
        <EditText
            android:id="@+id/me_name"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:hint="@string/activity_model_edit_005"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_006" />
        <EditText
            android:id="@+id/me_display_name"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:hint="@string/activity_model_edit_007"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/me_vision"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_008" />
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_009" />

        <CheckBox
            android:id="@+id/me_thinking"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_010" />

        <Button
            android:id="@+id/me_test"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_011" />
        <TextView
            android:id="@+id/me_test_result"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <!-- 能力探测：结果写回下面的两个勾选框 + 档位明细 -->
        <Button
            android:id="@+id/me_probe"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_012" />
        <TextView
            android:id="@+id/me_probe_result"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <!-- 设为默认：单独一行，不与「删除 / 保存」挤在一排（词典笔小屏三个按钮会被压到不可读） -->
        <Button
            android:id="@+id/me_set_default"
            android:textSize="13sp"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_model_edit_013" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/me_delete"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/activity_model_edit_014" />
            <Button
                android:id="@+id/me_save"
                android:textSize="13sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/activity_model_edit_015" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
