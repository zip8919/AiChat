<?xml version="1.0" encoding="utf-8"?>
<!-- 提示词预设管理页：单击打开预览，预览弹窗底部有「应用 / 修改 / 取消」；
     长按同样进预览（用户对这两种手势的预期都是「打开这一项」）。
     外层不套整页 ScrollView：ListView 自己滚，顶部工具栏固定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/preset_back"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回" />

        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="提示词预设" />
    </LinearLayout>

    <TextView
        android:id="@+id/preset_hint"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击任意一项查看内容，可应用、修改或取消。最多 20 个。" />

    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/preset_new"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="新建预设" />
        <Button
            android:id="@+id/preset_save_current"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:layout_marginLeft="6dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="保存当前提示词" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/preset_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />
        <TextView
            android:id="@+id/preset_empty"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="32dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:text="还没有预设。\n在设置页点「保存当前为预设」，或点上面的「新建预设」。" />
    </FrameLayout>
</LinearLayout>
