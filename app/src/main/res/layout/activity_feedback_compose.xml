<?xml version="1.0" encoding="utf-8"?>
<!-- 新建反馈：原生输入 + 原生文件选择，提交走反馈中心 multipart 接口。
     外层 ScrollView，键盘弹出时由 windowSoftInputMode=adjustResize 顶起。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/compose_back"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedbackcomposeactivity_002" />

            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/feedbackcomposeactivity_001" />

            <View
                android:layout_width="60dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/compose_notice"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:visibility="gone"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_003" />

        <EditText
            android:id="@+id/compose_title"
            android:textSize="14sp"
            android:singleLine="true"
            android:maxLength="80"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_004" />

        <EditText
            android:id="@+id/compose_body"
            android:textSize="14sp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="6"
            android:maxLines="12"
            android:maxLength="2000"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_032" />

        <EditText
            android:id="@+id/compose_nickname"
            android:textSize="14sp"
            android:singleLine="true"
            android:maxLength="20"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_005" />

        <EditText
            android:id="@+id/compose_contact"
            android:textSize="14sp"
            android:singleLine="true"
            android:maxLength="200"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_background"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/feedbackcomposeactivity_006" />

            <Button
                android:id="@+id/compose_pick_app"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:layout_marginRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedbackcomposeactivity_040" />

            <Button
                android:id="@+id/compose_pick"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedbackcomposeactivity_007" />
        </LinearLayout>

        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_008" />

        <TextView
            android:id="@+id/compose_upload_notice"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:paddingBottom="4dp"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_041" />

        <LinearLayout
            android:id="@+id/compose_files"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/compose_submit"
            android:textSize="15sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedbackcomposeactivity_009" />

        <TextView
            android:id="@+id/compose_footnote"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
