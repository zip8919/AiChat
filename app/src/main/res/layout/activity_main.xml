<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/primary" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp">
        <Button android:textSize="12sp" android:textColor="@color/primary" android:id="@+id/new_conversation_button" android:background="@android:color/white" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginRight="4dp" android:text="@string/new_conversation" />
        <Button android:textSize="12sp" android:textColor="@color/primary" android:id="@+id/history_button" android:background="@android:color/white" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginRight="8dp" android:text="@string/history" />
        <Button android:textSize="12sp" android:textColor="@color/primary" android:id="@+id/settings_button" android:background="@android:color/white" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/settings" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:textSize="14sp" android:textColor="@android:color/white" android:id="@+id/rotate_button" android:background="@android:color/transparent" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="40dp" android:text="↻" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/primary_dark" android:padding="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:id="@+id/model_row">
        <!-- 高度必须按内容自适应：选中项是「模型名 + 服务商」两行，写死 44dp 时
             Spinner 会以 EXACTLY 把该高度压给 item，第二行被裁到只剩字顶端几像素。
             minHeight 48dp 保住触控高度与头部行高（model_row 也是 48dp）。 -->
        <Spinner android:id="@+id/model_spinner" android:background="@android:color/white" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="2dp" android:paddingBottom="2dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/primary_dark" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:id="@+id/thinking_row">
        <TextView android:textSize="12sp" android:textColor="@android:color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="思考等级:" />
        <Spinner android:id="@+id/thinking_spinner" android:background="@android:color/white" android:padding="4dp" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="8dp" android:layout_weight="1" android:paddingTop="4dp" android:paddingBottom="4dp" />
        <Button android:id="@+id/scan_button" android:text="@string/scan" android:textSize="12sp" android:textColor="@android:color/white" android:background="@color/primary" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginLeft="8dp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/scroll_to_bottom_bar" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/message_webview" android:layout_width="match_parent" android:layout_height="match_parent" />
        <!-- 切换会话时的加载遮罩：盖在消息区上，输入栏与顶部按钮仍可见。
             clickable 拦住点击，避免加载中误触到底下的旧消息链接。 -->
        <LinearLayout android:id="@+id/conversation_loading_overlay" android:orientation="vertical" android:gravity="center" android:clickable="true" android:visibility="gone" android:background="#E6FFFFFF" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
            <ProgressBar android:id="@+id/loading_spinner" style="?android:attr/progressBarStyleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/loading_title" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在切换会话" />
            <TextView android:id="@+id/loading_detail" android:textSize="12sp" android:textColor="@color/text_secondary" android:gravity="center" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="准备中…" />
            <ProgressBar android:id="@+id/loading_progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/loading_percent" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" />
        </LinearLayout>
        <TextView android:id="@+id/scroll_to_bottom_button" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_scroll_bubble" android:gravity="center" android:includeFontPadding="false" android:layout_gravity="end|bottom" android:layout_marginRight="14dp" android:layout_marginBottom="10dp" android:visibility="gone" android:layout_width="38dp" android:layout_height="38dp" android:text="↓" />
    </FrameLayout>
    <LinearLayout android:id="@+id/queue_bar" android:gravity="center_vertical" android:orientation="horizontal" android:background="#FFF8E1" android:padding="4dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/queue_bar_text" android:textSize="12sp" android:textColor="#8D6E00" android:padding="4dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="排队 0 条" />
        <Button android:id="@+id/queue_manage_button" android:textSize="12sp" android:textColor="@color/primary" android:background="@android:color/transparent" android:padding="4dp" android:minHeight="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="管理" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/attachment_scroll" android:scrollbars="none" android:background="@color/background" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <LinearLayout android:id="@+id/attachment_bar" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </HorizontalScrollView>
    <TextView android:id="@+id/usage_bar" android:textSize="11sp" android:textColor="#777777" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" android:background="@color/background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/input_action_bar" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/white" android:paddingLeft="8dp" android:paddingRight="8dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="34dp">
            <TextView android:id="@+id/clear_input_button" android:textSize="20sp" android:textColor="#90a4ae" android:gravity="center" android:includeFontPadding="false" android:background="?android:attr/selectableItemBackground" android:layout_width="44dp" android:layout_height="34dp" android:contentDescription="清空输入" android:text="×" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/expand_button" android:background="?android:attr/selectableItemBackground" android:padding="4dp" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:src="@drawable/ic_expand" android:visibility="gone" android:contentDescription="@string/fullscreen_input" />
        </LinearLayout>
        <LinearLayout android:gravity="bottom" android:orientation="horizontal" android:background="@color/white" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/input_edit_text" android:background="@drawable/edit_text_background" android:padding="12dp" android:minHeight="44dp" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/input_hint" android:maxLines="4" android:layout_weight="1" android:inputType="textMultiLine" />
            <ImageButton android:id="@+id/plus_button" android:background="?android:attr/selectableItemBackground" android:padding="10dp" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginLeft="4dp" android:scaleType="fitCenter" android:src="@drawable/ic_plus" android:contentDescription="@string/attach" />
            <ImageButton android:id="@+id/send_button" android:background="@drawable/bg_send_button" android:padding="10dp" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="fitCenter" android:src="@drawable/ic_send" android:contentDescription="@string/send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>