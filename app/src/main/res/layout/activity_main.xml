<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top bar -->
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:id="@+id/new_conversation_button"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="@string/new_conversation"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:id="@+id/history_button"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/history"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:id="@+id/settings_button"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/rotate_button"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"/>
    </LinearLayout>

    <!-- Model selector row -->
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/primary_dark"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Spinner
            android:id="@+id/model_spinner"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Thinking level row -->
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/primary_dark"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="思考等级:"/>
        <Spinner
            android:id="@+id/thinking_spinner"
            android:background="@android:color/white"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/scan_button"
            android:text="@string/scan"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@color/primary"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <!-- Message display (WebView for rich HTML rendering) -->
    <WebView
        android:id="@+id/message_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Scroll-to-bottom button bar -->
    <LinearLayout
        android:id="@+id/scroll_to_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@color/background"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/scroll_to_bottom_button"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:minHeight="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓ 回到底部（长按清空输入框）"/>
    </LinearLayout>

    <!-- Queued messages bar (only visible while messages are waiting) -->
    <LinearLayout
        android:id="@+id/queue_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFF8E1"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/queue_bar_text"
            android:textSize="12sp"
            android:textColor="#8D6E00"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="排队 0 条"/>
        <Button
            android:id="@+id/queue_manage_button"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:minHeight="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="管理"/>
    </LinearLayout>

    <!-- 待发送附件条：选择文件后只在这里显示文件名，不碰输入框。
         真正的内容在发送时并入 apiText，气泡里只留一行摘要。 -->
    <HorizontalScrollView
        android:id="@+id/attachment_scroll"
        android:scrollbars="none"
        android:background="@color/background"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/attachment_bar"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- Bottom input bar
         右侧是竖排：上面全屏展开、下面发送。全屏用 GONE 而不是 INVISIBLE：
         它常驻会白占 30dp，窄屏上输入栏一直比改动前高 30dp。
         不会导致发送键跳动——外层 gravity=bottom、发送键是列内最后一个子元素，
         列变高只往上长，发送键底边和输入框底边都不动。
         加号放在发送左边，只负责附件菜单。 -->
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/input_edit_text"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/input_hint"
            android:maxLines="4"
            android:layout_weight="1"
            android:inputType="textMultiLine"/>
        <ImageButton
            android:id="@+id/plus_button"
            android:background="?android:attr/selectableItemBackground"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/attach"/>
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="44dp"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/expand_button"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_expand"
                android:visibility="gone"
                android:contentDescription="@string/fullscreen_input"/>
            <ImageButton
                android:id="@+id/send_button"
                android:background="@drawable/bg_send_button"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/send"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
