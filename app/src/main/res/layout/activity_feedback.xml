<?xml version="1.0" encoding="utf-8"?>
<!-- 反馈列表：顶部固定，中间 ListView 自己滚，底部翻页。
     列表项与详情都由本页发起，新建完成后回到这里刷新。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/feedback_back"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_002" />

        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_001" />

        <TextView
            android:id="@+id/feedback_refresh"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_005" />

        <TextView
            android:id="@+id/feedback_new"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_003" />
    </LinearLayout>

    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/feedbackactivity_004" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/feedback_list"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/feedback_loading"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/feedback_empty"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_006" />
    </FrameLayout>

    <TextView
        android:id="@+id/feedback_fold"
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:visibility="gone"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/feedback_prev"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_009" />

        <TextView
            android:id="@+id/feedback_page"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:layout_height="wrap_content"
            android:text="" />

        <Button
            android:id="@+id/feedback_next"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/feedbackactivity_010" />
    </LinearLayout>
</LinearLayout>
