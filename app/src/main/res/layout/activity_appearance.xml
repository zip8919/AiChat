<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/appearance_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/activity_appearance_001" />

        <!-- 未保存状态提示：CLEAN 时 GONE，不占高度避免布局跳动 -->
        <TextView
            android:id="@+id/appearance_status"
            android:textSize="12sp"
            android:textColor="#E67E22"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:text="" />

        <!-- 1 深色模式 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_002" />
            <Switch
                android:id="@+id/dark_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 2 主题颜色：标签行 + 常驻自定义入口；下方 5x2 网格由代码生成 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_003" />
            <TextView
                android:id="@+id/color_info"
                android:textSize="13sp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="@string/activity_appearance_tag_001"
                android:text="ⓘ" />
            <TextView
                android:id="@+id/color_custom"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_appearance_004" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/color_grid"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/color_selected"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="" />
            <TextView
                android:id="@+id/color_follow"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_appearance_005" />
        </LinearLayout>

        <!-- 16 色 + 字体的逐项编辑入口（二级页，避免主流程被 18 行淹没） -->
        <TextView
            android:id="@+id/attr_edit"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/activity_appearance_006" />

        <!-- 3 显示大小百分比 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_007" />
            <TextView
                android:id="@+id/scale_info"
                android:textSize="13sp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="@string/activity_appearance_tag_002"
                android:text="ⓘ" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <SeekBar
                android:id="@+id/scale_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200" />
            <TextView
                android:id="@+id/scale_value"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:gravity="right"
                android:typeface="monospace"
                android:singleLine="true"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="100%" />
        </LinearLayout>

        <TextView
            android:id="@+id/scale_warning"
            android:textSize="12sp"
            android:textColor="#C62828"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/activity_appearance_008" />

        <Button
            android:id="@+id/scale_preview"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/activity_appearance_009" />

        <!-- 4 字体大小档位 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_010" />
            <TextView
                android:id="@+id/font_size_info"
                android:textSize="13sp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="@string/activity_appearance_tag_003"
                android:text="ⓘ" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <SeekBar
                android:id="@+id/font_step_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4" />
            <TextView
                android:id="@+id/font_step_value"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:gravity="right"
                android:singleLine="true"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/activity_appearance_011" />
        </LinearLayout>

        <!-- 5 字体选择器 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_012" />
            <TextView
                android:id="@+id/font_follow"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_appearance_013" />
        </LinearLayout>

        <Spinner
            android:id="@+id/font_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- 6 自定义主题选择器（不是开关） -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_014" />
            <TextView
                android:id="@+id/theme_info"
                android:textSize="13sp"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="@string/activity_appearance_tag_004"
                android:text="ⓘ" />
        </LinearLayout>

        <Spinner
            android:id="@+id/theme_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/theme_meta"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/theme_font_missing"
            android:textSize="12sp"
            android:textColor="#B26A00"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/activity_appearance_015" />

        <!-- 7 两个管理按钮 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/manage_fonts"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:minWidth="0dp"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_016" />
            <Button
                android:id="@+id/manage_themes"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:minWidth="0dp"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_017" />
        </LinearLayout>

        <Button
            android:id="@+id/follow_all"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/activity_appearance_018" />

        <TextView
            android:id="@+id/save_info"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:clickable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="@string/activity_appearance_tag_005"
            android:text="@string/activity_appearance_019" />

        <!-- 8 底部三按钮：一行等宽，重置用描边样式在代码里设置 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">
            <Button
                android:id="@+id/btn_reset"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:minWidth="0dp"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_020" />
            <Button
                android:id="@+id/btn_temp"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:minWidth="0dp"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_021" />
            <Button
                android:id="@+id/btn_permanent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:minWidth="0dp"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_appearance_022" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
