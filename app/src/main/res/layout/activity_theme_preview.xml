<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pv_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">
        <Button
            android:id="@+id/btn_toggle_mode"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:minWidth="0dp"
            android:padding="4dp"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="浅色" />
        <Button
            android:id="@+id/btn_toggle_source"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:minWidth="0dp"
            android:padding="4dp"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="当前主题" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/pv_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/pv_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="主题预览" />

            <LinearLayout
                android:id="@+id/pv_card"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/pv_card_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="组标题卡片" />
                <TextView
                    android:id="@+id/pv_card_text"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="普通说明文字，用于观察次要文字颜色" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <Button
                    android:id="@+id/pv_btn_normal"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:minWidth="0dp"
                    android:padding="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="普通按钮" />
                <Button
                    android:id="@+id/pv_btn_primary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:minWidth="0dp"
                    android:padding="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="主色按钮" />
            </LinearLayout>

            <EditText
                android:id="@+id/pv_input"
                android:textSize="14sp"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="输入框示例" />

            <Spinner
                android:id="@+id/pv_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <Switch
                android:id="@+id/pv_switch"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="开关示例" />

            <TextView
                android:id="@+id/pv_bubble_user"
                android:textSize="14sp"
                android:padding="10dp"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="用户气泡：这是一条用户发出的消息" />

            <TextView
                android:id="@+id/pv_bubble_ai"
                android:textSize="14sp"
                android:padding="10dp"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="AI 气泡：这是一段回复，包含链接与代码块" />

            <TextView
                android:id="@+id/pv_code"
                android:textSize="12sp"
                android:typeface="monospace"
                android:padding="8dp"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="val x = 1  // 代码块样例" />

            <TextView
                android:id="@+id/pv_info"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ⓘ 说明行：主题只覆盖颜色与字体，不改布局" />

        </LinearLayout>
    </ScrollView>

    <!-- 单个 WebView 放在 ScrollView 外，避免嵌套滚动；高度固定，切主题时重灌不影响流式输出 -->
    <WebView
        android:id="@+id/pv_webview"
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">
        <Button
            android:id="@+id/btn_apply"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:minWidth="0dp"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="应用此主题" />
        <Button
            android:id="@+id/btn_back"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:minWidth="0dp"
            android:padding="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="返回" />
    </LinearLayout>

</LinearLayout>
