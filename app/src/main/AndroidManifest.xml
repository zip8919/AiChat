<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <application
        android:name="xyz.zip8919.app.aichat.AcApp"
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">

        <activity
            android:label="@string/app_name"
            android:name="xyz.zip8919.app.aichat.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:label="设置"
            android:name="xyz.zip8919.app.aichat.SettingsActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="对话历史"
            android:name="xyz.zip8919.app.aichat.ConversationManagerActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="@string/scan_title"
            android:name="xyz.zip8919.app.aichat.ScanActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="模型配置"
            android:name="xyz.zip8919.app.aichat.ModelConfigActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="小工具"
            android:name="xyz.zip8919.app.aichat.ToolsActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="JS 运行器"
            android:name="xyz.zip8919.app.aichat.JsRunnerActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <!-- 全屏输入自带顶栏，不能再叠一层系统 ActionBar -->
        <activity
            android:label="@string/fullscreen_input"
            android:name="xyz.zip8919.app.aichat.FullscreenInputActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <!-- 裁剪页自带顶栏，不能再叠一层系统 ActionBar -->
        <activity
            android:label="@string/crop_title"
            android:name="xyz.zip8919.app.aichat.CropActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="关于"
            android:name="xyz.zip8919.app.aichat.AboutActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="版本更新"
            android:name="xyz.zip8919.app.aichat.UpdateActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="使用统计"
            android:name="xyz.zip8919.app.aichat.StatsActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="存储空间"
            android:name="xyz.zip8919.app.aichat.StorageActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="图片附件"
            android:name="xyz.zip8919.app.aichat.StorageAttachmentsActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="已保存文件"
            android:name="xyz.zip8919.app.aichat.StorageFilesActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="外观"
            android:name="xyz.zip8919.app.aichat.AppearanceActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="逐属性编辑"
            android:name="xyz.zip8919.app.aichat.ThemeAttrActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="管理字体"
            android:name="xyz.zip8919.app.aichat.FontManagerActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="管理自定义主题"
            android:name="xyz.zip8919.app.aichat.ThemeManagerActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="编辑主题"
            android:name="xyz.zip8919.app.aichat.ThemeEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="主题生成提示词"
            android:name="xyz.zip8919.app.aichat.ThemePromptTemplateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <activity
            android:label="主题预览"
            android:name="xyz.zip8919.app.aichat.ThemePreviewActivity"
            android:exported="false"
            android:configChanges="screenSize|orientation|keyboardHidden"/>

        <!-- 相机输出：只暴露 cache/camera 下一个文件，靠 Intent 临时写授权，不对外开放 -->
        <provider
            android:name=".CameraOutputProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <!-- 文件外发：exports / attachments 两个目录的只读出口，用于第三方应用打开与分享 -->
        <provider
            android:name=".FilePathProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true"/>

    </application>
</manifest>
